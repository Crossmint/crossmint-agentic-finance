# Keypair paths
PAYER_KEYPAIR_PATH=./keypairs/payer.json
# PAYTO_KEYPAIR_PATH is only needed for the local server example
PAYTO_KEYPAIR_PATH=./keypairs/payto.json

# Solana Network: "devnet" or "mainnet-beta"
NETWORK=mainnet-beta

# Crossmint Configuration (production for mainnet)
CROSSMINT_API_KEY=sk_production_...
CROSSMINT_WALLET=
CROSSMINT_ENVIRONMENT=production

# Solana RPC URL (mainnet)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Resource URL — Corbits perftest endpoint (default)
# Change to http://127.0.0.1:3000/protected for local server testing
CROSSMINT_RESOURCE_URL=https://perftest.api.corbits.dev/protected

# --- Optional: Local server configuration ---
# PORT=3000
# FACILITATOR_URL=http://localhost:4000
