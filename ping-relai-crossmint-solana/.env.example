# Solana wallet address to receive payments
PAY_TO=YourSolanaWalletAddress

# Crossmint API key (server-side, from https://www.crossmint.com/console)
CROSSMINT_API_KEY=sk_production_...

# Crossmint smart wallet address (Solana)
CROSSMINT_WALLET=YourCrossmintWalletAddress

# Solana RPC URL (mainnet)
RPC_URL=https://api.mainnet-beta.solana.com

# Server port (default: 3000)
PORT=3000

# Target URL for client (default: http://localhost:3000/ping)
TARGET_URL=http://localhost:3000/ping
