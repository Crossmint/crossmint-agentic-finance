# Resource Server (the 402 paywall)
RESOURCE_PATH=/ping
PAYMENT_REQUIREMENT_AMOUNT=0.001
PAYMENT_REQUIREMENT_PAY_TO=nano_1yourPayToAddress... # replace with the merchant's Nano address
RESOURCE_SERVER_PORT=3100
FACILITATOR_PORT=3101

# Facilitator needs a Nano RPC to verify and settle blocks
# Public RPC example (read-only verification works; settle needs an RPC that accepts sends):
NANO_RPC_URL=https://rpc.nano.to
